---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Work from "../components/Work.astro";
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import { profile, experience, stack } from "../data/site";

const year = new Date().getFullYear();
---

<Base
  title={`${profile.name} | ${profile.headline}`}
  description={profile.subline}
>
  <Header />
  <main>
    <Hero />
    <Work />

    <section id="about" class="border-t border-line">
      <div class="wrap grid gap-14 py-16 sm:py-24 md:grid-cols-2">
        <div>
          <p class="label">Experience</p>
          <ul class="mt-6 space-y-7">
            {
              experience.map((e) => (
                <li>
                  <p class="display text-2xl">{e.title}</p>
                  <p class="mt-1 text-muted">{e.place}</p>
                  <p class="text-sm text-muted">{e.when}</p>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="label">What I work with</p>
          <dl class="stack-list mt-6">
            {
              stack.map((g) => (
                <>
                  <dt>{g.label}</dt>
                  <dd>{g.items}</dd>
                </>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <section id="contact" class="border-t border-line">
      <div class="wrap py-20 sm:py-32">
        <h2 class="display max-w-4xl text-[clamp(2.6rem,7vw,6rem)]">Have a project in mind?</h2>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href={profile.whatsapp} class="btn btn-wa" rel="noopener">
            <WhatsAppIcon />Message me on WhatsApp
          </a>
          <a href={`mailto:${profile.email}`} class="btn btn-ghost">{profile.email}</a>
        </div>
        <p class="mt-7 text-muted">
          {profile.phone} &middot; {profile.location} &middot;
          <a href={profile.github} class="underline hover:text-accent" rel="noopener">GitHub</a>
        </p>
      </div>
    </section>
  </main>

  <footer class="border-t border-line">
    <div class="wrap py-6 text-sm text-muted">&copy; {year} {profile.name}</div>
  </footer>
</Base>
