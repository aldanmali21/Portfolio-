---
import type { CaseStudy } from "../data/site";

interface Props {
  images: CaseStudy["images"];
}
const { images } = Astro.props;
---

<div class:list={["grid gap-4", images.length > 1 ? "grid-cols-3" : "grid-cols-1"]}>
  {
    images.map((img) =>
      "src" in img ? (
        <figure class="frame">
          <img src={img.src} alt={img.alt} width="640" loading="lazy" decoding="async" />
        </figure>
      ) : (
        <figure class="frame frame-placeholder" aria-label={`Placeholder: ${img.placeholder}`}>
          <div>
            <strong class="block text-ink">{img.placeholder}</strong>
            <span class="todo mt-2">screenshot coming</span>
          </div>
        </figure>
      ),
    )
  }
</div>
