---
import { profile } from "../data/site";
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/85 backdrop-blur">
  <div class="wrap flex items-center justify-between py-3">
    <a href="#top" class="display text-xl">{profile.name}</a>
    <nav class="flex items-center gap-4 text-sm sm:gap-6" aria-label="Main">
      <a href="#work" class="hidden hover:text-accent sm:inline">Work</a>
      <a href="#how" class="hidden hover:text-accent sm:inline">How I work</a>
      <a href="#about" class="hidden hover:text-accent sm:inline">About</a>
      <a href={profile.whatsapp} class="btn btn-primary !py-2 !text-sm">Message me</a>
    </nav>
  </div>
</header>
