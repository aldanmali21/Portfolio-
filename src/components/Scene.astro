---
import type { CaseStudy } from "../data/site";
import Phone from "./Phone.astro";

interface Props {
  study: CaseStudy;
}
const { study } = Astro.props;
const desktop = study.device === "desktop";
const first = study.images[0];
// Desktop projects show their phone view while the device is a phone.
const phoneImgs = desktop ? (study.mobile ?? [{ placeholder: "Mobile view" }]) : study.images;
---

<div class:list={["scene", desktop && "scene-desktop"]}>
  <div class="laptop" aria-hidden={desktop ? undefined : "true"}>
    <div class="laptop-lid">
      <div class="laptop-bezel">
        <div class="laptop-screen">
          <div class="chrome">
            <i></i><i></i><i></i>
            <span class="url">{study.urlLabel}</span>
          </div>
          {
            !desktop && (
              <div class="desk-shot desk-center">
                <div
                  class:list={["lap-shot", !("src" in first) && "is-ph"]}
                  style={"src" in first && first.aspect ? `--ar:${first.aspect};--tone:${first.tone ?? "#fff"}` : undefined}
                >
                  {"src" in first ? (
                    <img src={first.src} alt="" loading="eager" decoding="async" />
                  ) : (
                    <strong>{first.placeholder}</strong>
                  )}
                </div>
              </div>
            )
          }
          {
            desktop && (
              <div class="desk-shot">
                {"src" in first ? (
                  <img src={first.src} alt={first.alt} loading="eager" decoding="async" />
                ) : (
                  <div class="desk-placeholder">
                    <strong>{first.placeholder}</strong>
                    <span class="todo">screenshot to add</span>
                  </div>
                )}
              </div>
            )
          }
        </div>
      </div>
    </div>
    <div class="laptop-base"></div>
  </div>
  <div class:list={["phones", phoneImgs.length > 1 && "multi"]} aria-hidden={desktop ? "true" : undefined}>
    {phoneImgs.map((img) =>
      "src" in img ? (
        <Phone src={img.src} alt={img.alt} />
      ) : (
        <Phone label={img.placeholder} />
      ),
    )}
  </div>
</div>
