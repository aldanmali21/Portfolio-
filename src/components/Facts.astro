---
import type { Fact } from "../data/site";
import Todo from "./Todo.astro";

interface Props {
  facts: Fact[];
}
const { facts } = Astro.props;
---

<dl class="mt-6 grid gap-x-6 gap-y-3 text-sm sm:grid-cols-[auto_1fr]">
  {
    facts.map((f) => (
      <>
        <dt class="font-semibold">{f.label}</dt>
        <dd class="text-muted">{f.value ?? <Todo />}</dd>
      </>
    ))
  }
</dl>
