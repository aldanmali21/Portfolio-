---
import { projects } from "../data/site";
import Panel from "./Panel.astro";
import Device from "./Device.astro";

const n = projects.length;
---

<section id="work" class="work" data-work style={`--n:${n}`} aria-label="Selected work">
  <div class="work-intro wrap pt-14 pb-2">
    <p class="label">Selected work</p>
  </div>
  <div class="stage">
    <div class="bgs" aria-hidden="true">
      {projects.map((p) => <div class="bg" data-brand={p.id}></div>)}
    </div>
    <div class="track">
      {projects.map((p, i) => <Panel p={p} index={i} />)}
    </div>
    <Device />
    <div class="rail" data-rail>
      <span class="rail-count"><span data-rail-num>01 / 05</span><span class="rail-title" data-rail-title></span></span>
      <div class="rail-ticks">
        {
          projects.map((p, i) => (
            <button type="button" data-go={i} aria-label={`Go to ${p.title}`} aria-current={i === 0 ? "true" : "false"}>
              <i></i>
            </button>
          ))
        }
      </div>
      <span class="rail-hint">Keep scrolling</span>
    </div>
  </div>
</section>

<script>
  const work = document.querySelector<HTMLElement>("[data-work]");
  if (work) {
    const stage = work.querySelector<HTMLElement>(".stage")!;
    const track = work.querySelector<HTMLElement>(".track")!;
    const rail = work.querySelector<HTMLElement>("[data-rail]")!;
    const railNum = work.querySelector<HTMLElement>("[data-rail-num]")!;
    const railTitle = work.querySelector<HTMLElement>("[data-rail-title]")!;
    const panels = Array.from(work.querySelectorAll<HTMLElement>(".panel"));
    const bgs = Array.from(work.querySelectorAll<HTMLElement>(".bg"));
    const device = work.querySelector<HTMLElement>("[data-device]")!;
    const laptopEl = device.querySelector<HTMLElement>(".laptop")!;
    const lidEl = device.querySelector<HTMLElement>(".laptop-lid")!;
    const bezelEl = device.querySelector<HTMLElement>(".laptop-bezel")!;
    const baseEl = device.querySelector<HTMLElement>(".laptop-base")!;
    const lapScreenEl = device.querySelector<HTMLElement>(".laptop-screen")!;
    const phoneScreenEl = device.querySelector<HTMLElement>(".phone-screen")!;
    // What sits on the laptop's coloured desktop (the address bar and the screenshots).
    const lapContentEls = Array.from(
      device.querySelectorAll<HTMLElement>(".chrome, .lap-shot, .lap-slide .desk-shot"),
    );
    const phonesEl = device.querySelector<HTMLElement>("[data-phone]")!;
    const stripEls = Array.from(device.querySelectorAll<HTMLElement>("[data-strip]"));
    const urlEls = Array.from(device.querySelectorAll<HTMLElement>("[data-url]"));
    const extras = Array.from(document.querySelectorAll<HTMLElement>(".panel.extra"));
    const ticks = Array.from(work.querySelectorAll<HTMLButtonElement>("[data-go]"));
    const header = document.querySelector("header");
    const mq = window.matchMedia(
      "(min-width: 900px) and (min-height: 520px) and (prefers-reduced-motion: no-preference), (max-width: 899px) and (min-height: 640px) and (prefers-reduced-motion: no-preference)",
    );
    // Where the browser can run scroll-linked animations itself, the slide follows your
    // finger exactly instead of trailing it by a frame.
    const hasTimeline = !!(
      window.CSS &&
      CSS.supports &&
      CSS.supports("animation-timeline: scroll()") &&
      "ScrollTimeline" in window
    );

    const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
    const smooth = (t: number) => t * t * (3 - 2 * t);
    const pad = (i: number) => String(i + 1).padStart(2, "0");
    const headerH = () => (header ? header.getBoundingClientRect().height : 60);
    const span = () => work.offsetHeight - stage.offsetHeight;

    let pinned = false;
    let timeline = false;
    let raf = 0;
    let active = -1;

    // ONE laptop and ONE phone carry on through every project. For a scroll position u
    // (0 = first project centred, 1 = second, ...) this says what they look like:
    //   f: 0 = phone, 1 = laptop. Right after a project is centred the device changes to
    //      the other form (project 1: phone to laptop, project 2: laptop to phone, ...).
    //   c: which project's screen is showing (a fraction while it slides to the next).
    const MORPH = 0.5;
    const N = panels.length;
    // The slider runs one change longer than the last project: Akalimo is centred as a phone,
    // then turns into the laptop, and the scrolling ends when that change is finished.
    const maxU = N - 1 + MORPH;
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    // Sizes of the two devices, measured from the page (layout size ignores transforms).
    let geo = { sw: 1, sh: 1, lw: 1, lh: 1, lcx: 0, lcy: 0, pw: 1, ph: 1, dx: 0 };
    // How far the device travels between its two sides: the gap between where the first
    // (write-up left) and second (write-up right) project's hidden scene sits.
    const sceneX = (i: number) => panels[i]?.querySelector<HTMLElement>(".scene")?.offsetLeft ?? 0;
    function measure() {
      geo = {
        dx: sceneX(0) - sceneX(1),
        sw: device.offsetWidth,
        sh: device.offsetHeight,
        lw: laptopEl.offsetWidth,
        lh: laptopEl.offsetHeight,
        lcx: laptopEl.offsetLeft + laptopEl.offsetWidth / 2,
        lcy: laptopEl.offsetTop + laptopEl.offsetHeight / 2,
        pw: phonesEl.offsetWidth,
        ph: phonesEl.offsetHeight,
      };
    }

    function deviceState(u: number) {
      const U = clamp(u, 0, maxU);
      const k = Math.floor(U);
      const w = clamp((U - k) / MORPH, 0, 1);
      const f = k % 2 === 0 ? w : 1 - w;
      const c = k + smooth(clamp((U - k - MORPH) / (1 - MORPH), 0, 1));
      // The device switches sides with the write-up: right for projects 1, 3, 5, left for 2, 4.
      // It crosses over while the slider moves from one project to the next.
      const c2 = c % 2;
      const side = c2 <= 1 ? c2 : 2 - c2; // 0 = right, 1 = left

      // The laptop moulds into the phone (and the phone into the laptop): both are scaled
      // to follow ONE outline that goes from the laptop's wide rectangle to the phone's
      // tall one, so the shape itself changes instead of one device fading for another.
      const g = smooth(f); // 0 = phone shape, 1 = laptop shape
      const { sw, sh, lw, lh, lcx, lcy, pw, ph } = geo;
      const W = lerp(pw, lw, g);
      const H = lerp(ph, lh, g);
      const cx = lerp(sw / 2, lcx, g);
      const cy = lerp(sh / 2, lcy, g);
      const slx = W / lw; // laptop scale
      const sly = H / lh;
      const spx = W / pw; // phone scale
      const spy = H / ph;

      // Corner radius: follow the phone's rounded corners through the change, then settle
      // on the laptop's tighter ones. The scaling stretches corners, so they are divided
      // back out to keep the outline's corners round rather than oval.
      const rl = sw * 0.024; // laptop lid radius (2.4cqw)
      const rim = sw * 0.003; // metal rim around the bezel
      const rp = pw * 0.15; // phone body radius (15cqw of the phone)
      const h = smooth(clamp((g - 0.5) / 0.5, 0, 1));
      const vx = lerp(rp, rl, h);
      const vy = lerp(rp, rl, h);

      // The shells swap while their outlines coincide. The screens dissolve earlier than the
      // bodies change shape, so a stretched screenshot is never on show: the body moulds
      // first and the new screen lights up once it is nearly there.
      const ol = smooth(clamp((g - 0.15) / 0.25, 0, 1)); // laptop body in
      const op = 1 - smooth(clamp((g - 0.22) / 0.28, 0, 1)); // phone body out
      const ps = 1 - smooth(clamp((g - 0.04) / 0.26, 0, 1)); // phone screen goes first
      const ls = smooth(clamp((g - 0.3) / 0.28, 0, 1)); // the laptop's coloured desktop
      const lc = smooth(clamp((g - 0.6) / 0.3, 0, 1)); // then what is on it
      return {
        device: { translate: `${-geo.dx * side}px 0px` },
        laptop: {
          opacity: ol,
          transform: `translate(${cx - lcx}px, ${cy - lcy}px) scale(${slx}, ${sly})`,
        },
        lid: { borderRadius: `${vx / slx}px / ${vy / sly}px` },
        bezel: { borderRadius: `${Math.max(0, vx - rim) / slx}px / ${Math.max(0, vy - rim) / sly}px` },
        base: { opacity: smooth(clamp((g - 0.7) / 0.3, 0, 1)) },
        lapScreen: { opacity: ls },
        lapContent: { opacity: lc },
        phoneScreen: { opacity: ps },
        phones: {
          opacity: op,
          transform: `translate(-50%, -50%) translate(${cx - sw / 2}px, ${cy - sh / 2}px) scale(${spx}, ${spy})`,
        },
        strip: { transform: `translate3d(${(-c * 100) / N}%,0,0)` },
        urls: urlEls.map((_, i) => ({ opacity: clamp(1 - Math.abs(c - i) * 1.6, 0, 1) })),
      };
    }
    type DeviceState = ReturnType<typeof deviceState>;
    const deviceTargets: { el: HTMLElement; pick: (st: DeviceState) => Keyframe }[] = [
      { el: device, pick: (st) => st.device },
      { el: laptopEl, pick: (st) => st.laptop },
      { el: lidEl, pick: (st) => st.lid },
      { el: bezelEl, pick: (st) => st.bezel },
      { el: baseEl, pick: (st) => st.base },
      { el: lapScreenEl, pick: (st) => st.lapScreen },
      { el: phoneScreenEl, pick: (st) => st.phoneScreen },
      ...lapContentEls.map((el) => ({ el, pick: (st: DeviceState) => st.lapContent as Keyframe })),
      { el: phonesEl, pick: (st) => st.phones },
      ...stripEls.map((el) => ({ el, pick: (st: DeviceState) => st.strip as Keyframe })),
      ...urlEls.map((el, i) => ({ el, pick: (st: DeviceState) => st.urls[i] as Keyframe })),
    ];
    function applyDevice(u: number) {
      const st = deviceState(u);
      deviceTargets.forEach(({ el, pick }) => Object.assign(el.style, pick(st)));
    }
    function clearDevice() {
      deviceTargets.forEach(({ el, pick }) => {
        Object.keys(pick(deviceState(0))).forEach((k) => ((el.style as any)[k] = ""));
      });
    }

    // Scroll-linked: the same maths, sampled into keyframes the browser plays on its own.
    let deviceAnims: Animation[] = [];
    function cancelDeviceAnims() {
      deviceAnims.forEach((a) => a.cancel());
      deviceAnims = [];
    }
    function buildDeviceAnims(start: number, seg: number) {
      cancelDeviceAnims();
      measure();
      const maxScroll = document.documentElement.scrollHeight - innerHeight;
      if (maxScroll <= 0) return;
      const STEPS = 40;
      const total = Math.round(maxU * STEPS);
      const tl = new (window as any).ScrollTimeline({ source: document.scrollingElement, axis: "block" });
      const samples = Array.from({ length: total + 1 }, (_, i) => {
        const u = i / STEPS;
        return { offset: clamp((start + u * seg) / maxScroll, 0, 1), st: deviceState(u) };
      });
      const frames = (pick: (st: DeviceState) => Keyframe) => {
        const out: Keyframe[] = [];
        let prev = 0;
        const push = (offset: number, st: DeviceState) => {
          prev = Math.max(prev, offset);
          out.push({ offset: prev, ...pick(st) });
        };
        push(0, samples[0].st);
        samples.forEach((sm) => push(sm.offset, sm.st));
        push(1, samples[samples.length - 1].st);
        return out;
      };
      deviceTargets.forEach(({ el, pick }) =>
        deviceAnims.push(el.animate(frames(pick), { timeline: tl, fill: "both", easing: "linear" } as any)),
      );
    }

    // Tell the stylesheet where each animation starts and ends, in scroll pixels.
    function layoutTimeline() {
      const start = window.scrollY + work!.getBoundingClientRect().top - headerH();
      const sp = span();
      const seg = sp / maxU;
      work!.style.setProperty("--s", `${start}px`);
      // The sideways slide stops when the last project arrives; the final change plays after it.
      work!.style.setProperty("--e", `${start + (N - 1) * seg}px`);
      bgs.forEach((el, i) => {
        if (i === 0) return;
        const c = start + i * seg;
        el.style.setProperty("--bs", `${Math.max(0, c - 0.9 * seg)}px`);
        el.style.setProperty("--be", `${c - 0.1 * seg}px`);
      });
      buildDeviceAnims(start, seg);
      panels.forEach((el, i) => {
        const c = start + i * seg;
        el.style.setProperty("--ps", `${Math.max(0, c - seg)}px`);
        el.style.setProperty("--pe", `${c + seg}px`);
      });
    }
    let layoutRaf = 0;
    const relayout = () => {
      if (!pinned || !timeline || layoutRaf) return;
      layoutRaf = requestAnimationFrame(() => {
        layoutRaf = 0;
        layoutTimeline();
      });
    };

    function render() {
      raf = 0;
      if (!pinned) return;
      const hh = headerH();
      const rect = work!.getBoundingClientRect();
      const p = clamp((hh - rect.top) / span(), 0, 1);
      if (!timeline) {
        // Fallback for browsers without scroll-linked animations.
        const vw = stage.clientWidth;
        const u = p * maxU;
        const slide = Math.min(u, N - 1); // the slide stops on the last project
        track.style.transform = `translate3d(${-slide * vw}px,0,0)`;
        panels.forEach((el, i) => {
          const d = i - slide;
          el.style.setProperty("--d", String(clamp(d, -1, 1)));
        });
        applyDevice(u);
        bgs.forEach((el, i) => {
          if (i > 0) el.style.opacity = String(smooth(clamp((u - (i - 0.9)) / 0.8, 0, 1)));
        });
      }
      const idx = Math.round(Math.min(p * maxU, N - 1));
      if (idx !== active) {
        active = idx;
        ticks.forEach((t, i) => t.setAttribute("aria-current", String(i === idx)));
        railNum.textContent = `${pad(idx)} / ${pad(panels.length - 1)}`;
        railTitle.textContent = panels[idx].dataset.title ?? "";
        rail.setAttribute("data-brand", panels[idx].id);
      }
    }
    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(render);
    };

    // Stacked layout: play the phone-to-laptop morph as each panel scrolls into view.
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const el = e.target as HTMLElement;
          if (e.intersectionRatio >= 0.5) el.style.setProperty("--m", "1");
          else if (e.intersectionRatio < 0.15) el.style.setProperty("--m", "0");
        });
      },
      { threshold: [0, 0.15, 0.5] },
    );
    extras.forEach((el) => io.observe(el));

    const ro = new ResizeObserver(relayout);

    const onResize = () => {
      if (!timeline) measure();
      schedule();
      relayout();
    };

    function enablePinned() {
      pinned = true;
      panels.forEach((el) => io.unobserve(el));
      work!.classList.add("is-h");
      timeline = hasTimeline;
      measure();
      if (timeline) {
        layoutTimeline();
        work!.classList.add("tl");
        ro.observe(document.body);
        window.addEventListener("load", relayout);
      }
      window.addEventListener("scroll", schedule, { passive: true });
      window.addEventListener("resize", onResize);
      active = -1;
      render();
    }
    function disablePinned() {
      pinned = false;
      timeline = false;
      work!.classList.remove("is-h", "tl");
      ro.disconnect();
      window.removeEventListener("scroll", schedule);
      window.removeEventListener("resize", onResize);
      window.removeEventListener("load", relayout);
      track.style.transform = "";
      cancelDeviceAnims();
      clearDevice();
      ["--s", "--e"].forEach((v) => work!.style.removeProperty(v));
      bgs.forEach((el) => {
        el.style.opacity = "";
        ["--bs", "--be"].forEach((v) => el.style.removeProperty(v));
      });
      panels.forEach((el) => {
        ["--ps", "--pe"].forEach((v) => el.style.removeProperty(v));
        el.style.setProperty("--m", "0");
        el.style.setProperty("--d", "0");
        io.observe(el);
      });
    }
    const apply = () => (mq.matches ? enablePinned() : disablePinned());
    apply();
    mq.addEventListener("change", apply);

    function goTo(i: number, behavior: ScrollBehavior = "smooth") {
      if (pinned) {
        const absTop = window.scrollY + work!.getBoundingClientRect().top;
        const target = absTop - headerH() + (i / maxU) * span();
        window.scrollTo({ top: target, behavior });
      } else {
        panels[i].scrollIntoView({ behavior, block: "start" });
      }
    }
    ticks.forEach((t) => t.addEventListener("click", () => goTo(Number(t.dataset.go))));

    // "Other projects" button: reveals the projects that are not in the slider.
    const other = document.querySelector<HTMLElement>("[data-other]");
    const otherBtn = document.querySelector<HTMLButtonElement>("[data-other-btn]");
    const otherBody = document.querySelector<HTMLElement>("[data-other-body]");
    function setOther(open: boolean) {
      if (!otherBtn || !otherBody) return;
      otherBtn.setAttribute("aria-expanded", String(open));
      otherBody.toggleAttribute("data-collapsed", !open);
      otherBody.toggleAttribute("inert", !open);
    }
    if (otherBtn && otherBody) {
      otherBtn.hidden = false;
      setOther(false);
      otherBtn.addEventListener("click", () => {
        const open = otherBtn.getAttribute("aria-expanded") !== "true";
        setOther(open);
        if (open) setTimeout(() => other?.scrollIntoView({ behavior: "smooth", block: "start" }), 120);
      });
    }

    // Links to a project (including the hero's "See ..." links) scroll to its slide.
    document.addEventListener("click", (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
      if (!a) return;
      const id = a.getAttribute("href")!.slice(1);
      const i = panels.findIndex((p) => p.id === id);
      if (i >= 0) {
        e.preventDefault();
        goTo(i);
        return;
      }
      const extra = extras.find((p) => p.id === id);
      if (extra) {
        e.preventDefault();
        setOther(true);
        setTimeout(() => extra.scrollIntoView({ behavior: "smooth", block: "start" }), 450);
      }
    });

    // On touch screens a sideways swipe moves to the next or previous project.
    let sx = 0;
    let sy = 0;
    stage.addEventListener(
      "touchstart",
      (e) => {
        sx = e.touches[0].clientX;
        sy = e.touches[0].clientY;
      },
      { passive: true },
    );
    stage.addEventListener(
      "touchend",
      (e) => {
        if (!pinned) return;
        const dx = e.changedTouches[0].clientX - sx;
        const dy = e.changedTouches[0].clientY - sy;
        if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
        goTo(clamp(active + (dx < 0 ? 1 : -1), 0, panels.length - 1));
      },
      { passive: true },
    );

    // Tabbing into an off-screen slide brings it into view.
    panels.forEach((el, i) =>
      el.addEventListener("focusin", () => {
        if (pinned && i !== active) goTo(i, "auto");
      }),
    );
  }
</script>
