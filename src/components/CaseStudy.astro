---
import type { CaseStudy } from "../data/site";
import Frame from "./Frame.astro";
import Facts from "./Facts.astro";

interface Props {
  study: CaseStudy;
  index: number;
}
const { study, index } = Astro.props;
const flip = index % 2 === 1;
---

<article id={study.id} data-title={study.title} data-brand={study.id} class="case">
<div class="wrap grid items-center gap-10 py-14 md:grid-cols-2 md:gap-16 md:py-24">
  <div class:list={[flip && "md:order-2"]}>
    <p class="eyebrow">
      <span class="brand-dot" aria-hidden="true"></span>{study.kicker}
      {
        study.status && (
          <span class="ml-2 rounded-full bg-accent-soft px-2 py-0.5 normal-case tracking-normal">
            {study.status}
          </span>
        )
      }
    </p>
    <h3 class="display mt-3 text-4xl sm:text-5xl">{study.title}</h3>
    <p class="mt-5 text-lg text-muted">{study.summary}</p>
    <ul class="mt-5 space-y-2">
      {
        study.points.map((p) => (
          <li class="flex gap-3">
            <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
            <span>{p}</span>
          </li>
        ))
      }
    </ul>
    <Facts facts={study.facts} />
    {
      study.link && (
        <a href={study.link.href} class="btn btn-ghost mt-6" rel="noopener" target="_blank">
          {study.link.label} <span aria-hidden="true">&#8599;</span>
        </a>
      )
    }
  </div>
  <div class:list={["media", flip && "md:order-1"]}>
    <Frame images={study.images} />
  </div>
</div>
</article>
