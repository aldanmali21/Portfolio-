---
// PROTOTYPE (throwaway): hero direction A, "Live workflow".
// Split hero: the pitch on the left, an illustrated feed of busywork being
// handled automatically on the right (below the pitch on phones).
import { profile, currently } from "../../data/site";
import WhatsAppIcon from "../WhatsAppIcon.astro";
---

<div data-v="a" class="hA">
  <div class="hA-grid">
    <div class="hA-copy">
      <p class="hA-pill">
        <span class="hA-dot" aria-hidden="true"></span>
        <span>{profile.availability}</span>
        <span class="hA-sep" aria-hidden="true"></span>
        <span class="text-muted">{profile.location} · <span data-clock class="tabular-nums"></span></span>
      </p>

      <h1 class="display hA-h">Software that does the <span class="hA-em">busywork.</span></h1>
      <p class="hA-sub">{profile.subline}</p>

      <div class="hA-ctas">
        <a href={profile.whatsapp} class="btn btn-wa" rel="noopener"><WhatsAppIcon />Message me</a>
        <a href={`mailto:${profile.email}`} class="btn btn-ghost">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>Email me
        </a>
      </div>

      <a href={currently.href} class="hA-now">
        <span class="hA-live" aria-hidden="true"></span>
        <span class="text-muted">Now building</span>
        <strong>{currently.name}</strong>
        <span aria-hidden="true" class="hA-arrow">→</span>
      </a>
    </div>

    <figure class="hA-card" aria-label="Illustration: everyday busywork handled automatically">
      <div class="hA-card-head">
        <div>
          <p class="hA-card-title">Today, handled for you</p>
          <p class="hA-card-meta">Follow-ups running on autopilot</p>
        </div>
        <span class="hA-toggle"><span></span>Auto</span>
      </div>

      <ol class="hA-feed">
        <li style="--r:0">
          <span class="hA-ic hA-ic-wa"><WhatsAppIcon size={16} /></span>
          <span class="hA-txt"><b>New WhatsApp enquiry</b><small>“Is the 2-bedroom in Kira still free?”</small></span>
          <span class="hA-st"><i>Replying…</i><em>Answered</em></span>
        </li>
        <li style="--r:1">
          <span class="hA-ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2" /><path d="M8 2v4M16 2v4M3 10h18" /></svg></span>
          <span class="hA-txt"><b>Viewing booked</b><small>Sat 10:00, added to the agent’s calendar</small></span>
          <span class="hA-st"><i>Booking…</i><em>Booked</em></span>
        </li>
        <li style="--r:2">
          <span class="hA-ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 8 3 8H3s3-1 3-8" /><path d="M10 20a2 2 0 0 0 4 0" /></svg></span>
          <span class="hA-txt"><b>Appointment reminders</b><small>Sent to tomorrow’s clinic patients</small></span>
          <span class="hA-st"><i>Sending…</i><em>Sent</em></span>
        </li>
        <li style="--r:3">
          <span class="hA-ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 2h12v20l-3-2-3 2-3-2-3 2z" /><path d="M9 7h6M9 11h6" /></svg></span>
          <span class="hA-txt"><b>Invoice follow-up</b><small>A polite nudge for an unpaid invoice</small></span>
          <span class="hA-st"><i>Queued…</i><em>Sent</em></span>
        </li>
      </ol>

      <figcaption class="hA-card-foot">
        <span>Messages you had to type</span><strong>0</strong>
      </figcaption>
    </figure>
  </div>
</div>

<style is:global>
  .hA {
    position: relative;
  }
  .hA::before {
    /* soft brand glow + dotted grid behind the hero */
    content: "";
    position: absolute;
    inset: -6rem -1.25rem -2rem;
    z-index: -1;
    background:
      radial-gradient(40rem 26rem at 78% 40%, color-mix(in oklab, var(--accent) 16%, transparent), transparent 70%),
      radial-gradient(circle at 1px 1px, color-mix(in oklab, var(--ink) 9%, transparent) 1px, transparent 0) 0 0 / 22px 22px;
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
    pointer-events: none;
  }
  .hA-grid {
    display: grid;
    gap: 2.75rem;
    align-items: center;
  }
  @media (min-width: 960px) {
    .hA-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3.5rem;
    }
  }
  .hA-pill {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.6rem;
    padding: 0.4rem 0.85rem 0.4rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in oklab, var(--paper) 80%, transparent);
    font-size: 0.82rem;
    font-weight: 500;
  }
  .hA-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: #25d366;
    box-shadow: 0 0 0 0 #25d36680;
    animation: hA-ping 2s infinite;
  }
  @keyframes hA-ping {
    70% {
      box-shadow: 0 0 0 7px #25d36600;
    }
  }
  .hA-sep {
    width: 1px;
    height: 0.9rem;
    background: var(--line);
  }
  .hA-h {
    margin-top: 1.5rem;
    font-size: clamp(2.75rem, 11vw, 5.6rem);
    letter-spacing: -0.045em;
    line-height: 0.95;
    max-width: 12ch;
  }
  .hA-em {
    color: var(--accent);
    background: linear-gradient(transparent 68%, var(--accent-soft) 0);
    padding-inline: 0.04em;
  }
  .hA-sub {
    margin-top: 1.4rem;
    max-width: 34rem;
    font-size: clamp(1.02rem, 2.6vw, 1.2rem);
    color: var(--muted);
  }
  .hA-ctas {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
    max-width: 26rem;
  }
  .hA-ctas .btn {
    justify-content: center;
    padding-block: 0.9rem;
  }
  .hA-ctas .btn-wa {
    box-shadow: 0 8px 22px -10px #25d366;
  }
  .hA-now {
    margin-top: 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.9rem;
  }
  .hA-now:hover strong {
    color: var(--accent);
  }
  .hA-now:hover .hA-arrow {
    transform: translateX(3px);
  }
  .hA-arrow {
    transition: transform 0.15s;
  }
  .hA-live {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 2px;
    background: var(--accent);
    animation: hA-blink 1.2s steps(2) infinite;
  }
  @keyframes hA-blink {
    50% {
      opacity: 0.25;
    }
  }

  /* Card */
  .hA-card {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 1.4rem;
    background: color-mix(in oklab, var(--paper) 92%, var(--accent) 3%);
    box-shadow:
      0 1px 0 #ffffff10 inset,
      0 30px 60px -30px color-mix(in oklab, var(--ink) 35%, transparent);
    padding: 1.1rem;
    max-width: 30rem;
    width: 100%;
    justify-self: center;
  }
  @media (min-width: 960px) {
    .hA-card {
      transform: rotate(1.2deg);
    }
  }
  .hA-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.2rem 0.3rem 0.9rem;
    border-bottom: 1px dashed var(--line);
  }
  .hA-card-title {
    font-weight: 600;
  }
  .hA-card-meta {
    font-size: 0.78rem;
    color: var(--muted);
  }
  .hA-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
  }
  .hA-toggle span {
    width: 1.9rem;
    height: 1.1rem;
    border-radius: 999px;
    background: var(--accent);
    position: relative;
  }
  .hA-toggle span::after {
    content: "";
    position: absolute;
    top: 0.15rem;
    right: 0.15rem;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 999px;
    background: var(--accent-ink);
  }
  .hA-feed {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }
  .hA-feed li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.75rem;
    border-radius: 0.9rem;
    background: var(--paper);
    border: 1px solid var(--line);
    animation: hA-in 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--r) * 0.55s + 0.4s);
  }
  @keyframes hA-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
  }
  .hA-ic {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 0.65rem;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .hA-ic-wa {
    background: #25d36622;
    color: #128c4a;
  }
  .hA-txt {
    min-width: 0;
    display: grid;
    line-height: 1.3;
  }
  .hA-txt b {
    font-size: 0.88rem;
    font-weight: 600;
  }
  .hA-txt small {
    font-size: 0.76rem;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hA-st {
    display: grid;
    font-size: 0.72rem;
    font-weight: 600;
  }
  .hA-st > * {
    grid-area: 1 / 1;
    font-style: normal;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    text-align: center;
  }
  .hA-st i {
    color: var(--muted);
    background: var(--paper-2);
    animation: hA-out 0.3s both;
    animation-delay: calc(var(--r) * 0.55s + 1.5s);
  }
  .hA-st em {
    color: var(--accent);
    background: var(--accent-soft);
    animation: hA-show 0.3s both;
    animation-delay: calc(var(--r) * 0.55s + 1.5s);
  }
  @keyframes hA-out {
    to {
      opacity: 0;
    }
  }
  @keyframes hA-show {
    from {
      opacity: 0;
      transform: scale(0.85);
    }
  }
  .hA-card-foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 0.9rem;
    padding: 0.2rem 0.3rem 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .hA-card-foot strong {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--ink);
  }
  @media (max-width: 420px) {
    .hA-feed li:nth-child(4) {
      display: none;
    }
  }
</style>
