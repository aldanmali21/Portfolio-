---
// PROTOTYPE (throwaway): hero direction C, "Bento".
// A deep-green statement panel plus small tiles: who and where (with a big
// live clock), what's being built now (with a real screenshot), and the three
// kinds of work, each jumping to a matching case study.
import { profile, currently } from "../../data/site";
import WhatsAppIcon from "../WhatsAppIcon.astro";

const services = [
  { title: "Websites that book clients", href: "#kampala-dermatology", n: "01" },
  { title: "Systems that run operations", href: "#farmarq", n: "02" },
  { title: "AI that answers and follows up", href: "#real-estate-ai", n: "03" },
];
---

<div data-v="c" class="hC">
  <div class="hC-grid">
    <div class="hC-main">
      <p class="hC-pill"><span class="hC-dot" aria-hidden="true"></span>{profile.availability}</p>
      <h1 class="display hC-h">Software that does the <span class="hC-em">busywork.</span></h1>
      <p class="hC-sub">{profile.subline}</p>
      <div class="hC-ctas">
        <a href={profile.whatsapp} class="btn btn-wa" rel="noopener"><WhatsAppIcon />Message me</a>
        <a href={`mailto:${profile.email}`} class="btn hC-ghost">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>Email me
        </a>
      </div>
    </div>

    <div class="hC-tile hC-id">
      <div class="hC-avatar" aria-hidden="true">CW</div>
      <div>
        <p class="hC-name">{profile.name}</p>
        <p class="hC-role">Software developer</p>
      </div>
      <div class="hC-clock">
        <span data-clock class="tabular-nums"></span>
        <small>in {profile.location}</small>
      </div>
    </div>

    <a href={currently.href} class="hC-tile hC-now">
      <div>
        <p class="hC-label"><span class="hC-live" aria-hidden="true"></span>Now building</p>
        <p class="hC-now-title">{currently.name}</p>
        <p class="hC-now-sub">A software consultancy</p>
      </div>
      <img src="/images/afritam-mobile.webp" alt="" width="252" height="560" loading="eager" />
    </a>

    <div class="hC-tile hC-services">
      <p class="hC-label">What I build</p>
      <ul>
        {
          services.map((s) => (
            <li>
              <a href={s.href}>
                <span class="hC-n">{s.n}</span>
                <span class="hC-s">{s.title}</span>
                <span class="hC-go" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<style is:global>
  .hC {
    --panel: light-dark(#0f6b5b, #12392f);
    --panel-2: light-dark(#0a4f43, #0c2822);
    --panel-ink: #f4f1ea;
    --panel-em: light-dark(#9ff0d4, #6fe0bd);
  }
  .hC-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr 1fr;
  }
  .hC-main {
    grid-column: 1 / -1;
    position: relative;
    overflow: hidden;
    border-radius: 1.6rem;
    padding: clamp(1.4rem, 5vw, 3rem);
    color: var(--panel-ink);
    background:
      radial-gradient(30rem 20rem at 100% 0%, #ffffff1f, transparent 60%),
      linear-gradient(160deg, var(--panel), var(--panel-2));
  }
  .hC-main::after {
    /* faint grid lines, like a blueprint */
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(#ffffff0d 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, #ffffff0d 1px, transparent 1px) 0 0 / 32px 32px;
    mask-image: linear-gradient(200deg, #000, transparent 65%);
    pointer-events: none;
  }
  .hC-main > * {
    position: relative;
    z-index: 1;
  }
  .hC-pill {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: #ffffff1a;
    border: 1px solid #ffffff24;
    font-size: 0.8rem;
    font-weight: 500;
  }
  .hC-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: #25d366;
    box-shadow: 0 0 10px #25d366;
  }
  .hC-h {
    margin-top: 1.3rem;
    font-size: clamp(2.6rem, 10.5vw, 6rem);
    letter-spacing: -0.045em;
    line-height: 0.95;
    max-width: 11ch;
  }
  .hC-em {
    color: var(--panel-em);
  }
  .hC-sub {
    margin-top: 1.2rem;
    max-width: 36rem;
    font-size: clamp(1rem, 2.5vw, 1.15rem);
    color: #f4f1eacc;
  }
  .hC-ctas {
    margin-top: 1.75rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
    max-width: 24rem;
  }
  .hC-ctas .btn {
    justify-content: center;
    padding-block: 0.9rem;
  }
  .hC-ghost {
    border: 1px solid #ffffff40;
    color: var(--panel-ink);
  }
  .hC-ghost:hover {
    background: #ffffff14;
  }

  .hC-tile {
    border: 1px solid var(--line);
    border-radius: 1.3rem;
    background: var(--paper-2);
    padding: 1rem;
  }
  .hC-label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--accent);
  }

  .hC-id {
    display: grid;
    align-content: space-between;
    gap: 0.9rem;
  }
  .hC-avatar {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .hC-name {
    font-weight: 600;
    line-height: 1.2;
  }
  .hC-role {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .hC-clock span {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 8vw, 3rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .hC-clock small {
    font-size: 0.78rem;
    color: var(--muted);
  }

  .hC-now {
    position: relative;
    overflow: hidden;
    display: grid;
    align-content: start;
    min-height: 14.5rem;
    transition: border-color 0.15s;
  }
  .hC-now:hover {
    border-color: var(--accent);
  }
  .hC-now-title {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .hC-now-sub {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .hC-now img {
    position: absolute;
    right: 0.8rem;
    bottom: -5.5rem;
    width: 5.6rem;
    border-radius: 0.9rem;
    border: 4px solid var(--ink);
    transform: rotate(-6deg);
    box-shadow: 0 18px 30px -12px #0007;
    transition: transform 0.3s;
  }
  .hC-now:hover img {
    transform: rotate(-3deg) translateY(-6px);
  }
  .hC-live {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 2px;
    background: var(--accent);
    animation: hC-blink 1.2s steps(2) infinite;
  }
  @keyframes hC-blink {
    50% {
      opacity: 0.25;
    }
  }

  .hC-services {
    grid-column: 1 / -1;
  }
  .hC-services ul {
    margin-top: 0.4rem;
  }
  .hC-services li + li {
    border-top: 1px solid var(--line);
  }
  .hC-services a {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    align-items: center;
    padding: 0.8rem 0.1rem;
  }
  .hC-n {
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .hC-s {
    font-weight: 600;
  }
  .hC-go {
    color: var(--accent);
    transition: transform 0.15s;
  }
  .hC-services a:hover .hC-go {
    transform: translate(2px, -2px);
  }

  @media (min-width: 900px) {
    .hC-grid {
      grid-template-columns: 1.7fr 1fr;
      grid-template-rows: auto auto auto;
      gap: 1rem;
    }
    .hC-main {
      grid-column: 1;
      grid-row: 1 / 3;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      min-height: 32rem;
    }
    .hC-id,
    .hC-now {
      grid-column: 2;
      padding: 1.4rem;
    }
    .hC-now {
      min-height: 0;
    }
    .hC-now img {
      width: 7.5rem;
      bottom: -5.5rem;
    }
    .hC-services {
      padding: 0.6rem 1.4rem;
      display: flex;
      align-items: center;
      gap: 2rem;
    }
    .hC-services ul {
      flex: 1;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      margin: 0;
    }
    .hC-services li + li {
      border-top: 0;
      border-left: 1px solid var(--line);
      padding-left: 1.2rem;
    }
  }
</style>
