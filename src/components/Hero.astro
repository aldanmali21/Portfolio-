---
import { profile, currently, needs } from "../data/site";
import WhatsAppIcon from "./WhatsAppIcon.astro";

const words = profile.headline.split(" ");
---

<section id="top" class="wrap pb-16 pt-12 sm:pb-24 sm:pt-20">
  <p class="mb-7 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted">
    <span class="inline-flex items-center gap-2">
      <span class="h-2 w-2 rounded-full bg-[#25d366]" aria-hidden="true"></span>
      {profile.availability}
    </span>
    <span>
      {profile.location}<span id="local-time" class="tabular-nums"></span>
    </span>
  </p>

  <h1 class="display headline max-w-5xl text-[clamp(3.1rem,9.5vw,8.2rem)]">
    {words.map((w, i) => <><span class="word" style={`--i:${i}`}>{w}</span>{" "}</>)}
  </h1>
  <p class="mt-7 max-w-2xl text-lg text-muted sm:text-xl">{profile.subline}</p>

  <div class="mt-9 flex flex-wrap items-center gap-3">
    <a href={profile.whatsapp} class="btn btn-wa" rel="noopener">
      <WhatsAppIcon />Message me
    </a>
    <a href={`mailto:${profile.email}`} class="btn btn-ghost">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>Email me
    </a>
  </div>

  <p class="mt-7 text-sm text-muted">
    {currently.text}{" "}
    {
      currently.link ? (
        <a href={currently.link.href} class="underline hover:text-accent">
          {currently.link.label}
        </a>
      ) : (
        <span class="todo">Afritam link to add</span>
      )
    }
  </p>

  <div id="needs" class="mt-14 js-only" hidden>
    <p class="label mb-3">What do you need built?</p>
    <div class="flex flex-wrap gap-2" role="group" aria-label="What do you need built?">
      {
        needs.map((n) => (
          <button
            type="button"
            class="chip"
            aria-pressed="false"
            data-need={n.id}
            data-pitch={n.pitch}
            data-targets={n.targets.join(",")}
          >
            {n.label}
          </button>
        ))
      }
    </div>
    <div
      id="need-result"
      class="mt-4 max-w-2xl rounded-xl bg-accent-soft p-4 text-sm"
      aria-live="polite"
      hidden
    >
      <p id="need-pitch"></p>
      <p id="need-links" class="mt-2 font-semibold"></p>
    </div>
  </div>
</section>

<script>
  const root = document.getElementById("needs");
  if (root) {
    root.hidden = false;
    const chips = Array.from(root.querySelectorAll<HTMLButtonElement>(".chip"));
    const result = document.getElementById("need-result")!;
    const pitch = document.getElementById("need-pitch")!;
    const links = document.getElementById("need-links")!;

    const hero = document.getElementById("top")!;
    const clear = () => {
      document.querySelectorAll(".is-match").forEach((el) => el.classList.remove("is-match"));
      hero.removeAttribute("data-brand");
    };

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const wasOn = chip.getAttribute("aria-pressed") === "true";
        chips.forEach((c) => c.setAttribute("aria-pressed", "false"));
        clear();
        if (wasOn) {
          result.hidden = true;
          return;
        }
        chip.setAttribute("aria-pressed", "true");
        const first = (chip.dataset.targets ?? "").split(",")[0];
        if (first) hero.setAttribute("data-brand", first);
        pitch.textContent = chip.dataset.pitch ?? "";
        links.replaceChildren();
        (chip.dataset.targets ?? "").split(",").forEach((id, i) => {
          const target = document.getElementById(id);
          if (!target) return;
          target.classList.add("is-match");
          const a = document.createElement("a");
          a.href = `#${id}`;
          a.className = "underline";
          a.textContent = `See ${target.dataset.title ?? id} →`;
          if (i > 0) links.append("  ·  ");
          links.append(a);
        });
        result.hidden = false;
      });
    });
  }

  const clock = document.getElementById("local-time");
  if (clock) {
    const fmt = new Intl.DateTimeFormat("en-GB", {
      hour: "2-digit",
      minute: "2-digit",
      timeZone: "Africa/Kampala",
    });
    const tick = () => (clock.textContent = ` \u00b7 ${fmt.format(new Date())} local time`);
    tick();
    setInterval(tick, 30000);
  }
</script>
